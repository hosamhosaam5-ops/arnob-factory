  "scenes": [
    {
      "sceneLabel": "المقطع 1",
      "durationSeconds": null,
      "narrationText": "أَهْلًا يا أَصْدِقائِي! أَنا فُسْتُق.",
      "visualCue": "فستق يحيّي الأطفال، وبندق يستمع بفم مغلق",
      "speakerId": "fustuq"
    },
    {
      "sceneLabel": "المقطع 2",
      "durationSeconds": null,
      "narrationText": "وَأَنا بُنْدُق. اليَوْمَ نَتَعَلَّمُ حَرْفَ الأَلِف.",
      "visualCue": "بندق يقدّم موضوع الدرس ويشير إلى حرف الألف",
      "speakerId": "bondoq"
    },
    {
      "sceneLabel": "المقطع 3",
      "durationSeconds": null,
      "narrationText": "أَلِف... أَرْنَب! أَرْنَبٌ صَغِيرٌ يَقْفِزُ.",
      "visualCue": "إبراز رسم الأرنب الأصلي وتمييز بطاقة الكلمة",
      "speakerId": "fustuq"
    },
    {
      "sceneLabel": "المقطع 4",
      "durationSeconds": null,
      "narrationText": "أَلِف... أَسَد! أَسَدٌ قَوِيٌّ يُزَمْجِرُ.",
      "visualCue": "إبراز رسم الأسد الأصلي وتمييز بطاقة الكلمة",
      "speakerId": "bondoq"
    },
    {
      "sceneLabel": "المقطع 5",
      "durationSeconds": null,
      "narrationText": "أَلِف... أُذُن! نَسْمَعُ بِالأُذُنِ.",
      "visualCue": "إبراز رسم الأذن الأصلي وتمييز بطاقة الكلمة",
      "speakerId": "fustuq"
    },
    {
      "sceneLabel": "المقطع 6",
      "durationSeconds": null,
      "narrationText": "أَلِف... إِبْرَة! نَخِيطُ بِها الثَّوْب.",
      "visualCue": "إبراز رسم الإبرة الأصلي وتمييز بطاقة الكلمة",
      "speakerId": "bondoq"
    },
    {
      "sceneLabel": "المقطع 7",
      "durationSeconds": null,
      "narrationText": "رَدِّدُوا مَعَنا: أَلِف! أَرْنَب، أَسَد، أُذُن، إِبْرَة.",
      "visualCue": "عرض البطاقات الأربع بالترتيب مع إعادة النطق",
      "speakerId": "fustuq"
    },
    {
      "sceneLabel": "المقطع 8",
      "durationSeconds": null,
      "narrationText": "أَحْسَنْتُمْ! إِلَى اللِّقاءِ يا أَصْدِقائِي.",
      "visualCue": "ختام هادئ؛ بندق يتحدث وفستق يستمع",
      "speakerId": "bondoq"
    }
  ],
